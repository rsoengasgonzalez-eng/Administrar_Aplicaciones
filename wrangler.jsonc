{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "administrar-aplicaciones",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-11",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "PLANES_STORE",
        "class_name": "PlansStore"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PlansStore"
      ]
    }
  ]
}
